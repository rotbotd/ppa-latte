#!/usr/bin/env bash
set -euo pipefail

test -s LATTE-REVISION
test -s src/Chapter01/While.lt
test -s generated/Chapter01/While.fst
test -s src/Chapter01/ReachingDefinitions.lt
test -s generated/Chapter01/ReachingDefinitions.fst
test -s src/Chapter01/InstrumentedSemantics.lt
test -s generated/Chapter01/InstrumentedSemantics.fst
test -s src/Chapter01/AnalysisSoundness.lt
test -s generated/Chapter01/AnalysisSoundness.fst

grep -Fq 'tactics: disabled' src/Chapter01/While.lt

grep -Fq '#push-options "--no_tactics"' generated/Chapter01/While.fst

if grep -REn '^[[:space:]]*proof(!)?\b|\bsquash\b' src; then
  printf 'Latte source contains a solver-discharge proof surface\n' >&2
  exit 1
fi

if grep -REn '\bLemma\b|\bsquash\b|\badmit\b|assume val|admit_smt_queries' generated; then
  printf 'generated view contains a solver-discharge or admission surface\n' >&2
  exit 1
fi
