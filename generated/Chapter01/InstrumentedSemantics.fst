(* Latte generated F* view *)
module InstrumentedSemantics

#push-options "--no_tactics"
open While

open ReachingDefinitions

noeq type instrumented_big_step : (program: statement) -> (before_state: state) -> (before_writer: last_writer) -> (after_state: state) -> (after_writer: last_writer) -> Type =
| InstrumentedAssign: mark: label -> name: variable -> value: arithmetic_expression -> current: state -> writers: last_writer -> instrumented_big_step (Assign mark name value) current writers (write current name (evaluate_arithmetic value current)) (last_writer_write writers name mark)
| InstrumentedSkip: mark: label -> current: state -> writers: last_writer -> instrumented_big_step (Skip mark) current writers current writers
| InstrumentedSequence: first: statement -> second: statement -> before_state: state -> before_writer: last_writer -> middle_state: state -> middle_writer: last_writer -> after_state: state -> after_writer: last_writer -> first_step: instrumented_big_step first before_state before_writer middle_state middle_writer -> second_step: instrumented_big_step second middle_state middle_writer after_state after_writer -> instrumented_big_step (Sequence first second) before_state before_writer after_state after_writer
| InstrumentedIfTrue: mark: label -> guard: boolean_expression -> yes: statement -> no: statement -> before_state: state -> before_writer: last_writer -> after_state: state -> after_writer: last_writer -> guard_true: equality (evaluate_boolean guard before_state) true -> branch: instrumented_big_step yes before_state before_writer after_state after_writer -> instrumented_big_step (If mark guard yes no) before_state before_writer after_state after_writer
| InstrumentedIfFalse: mark: label -> guard: boolean_expression -> yes: statement -> no: statement -> before_state: state -> before_writer: last_writer -> after_state: state -> after_writer: last_writer -> guard_false: equality (evaluate_boolean guard before_state) false -> branch: instrumented_big_step no before_state before_writer after_state after_writer -> instrumented_big_step (If mark guard yes no) before_state before_writer after_state after_writer
| InstrumentedWhileFalse: mark: label -> guard: boolean_expression -> body: statement -> before_state: state -> before_writer: last_writer -> guard_false: equality (evaluate_boolean guard before_state) false -> instrumented_big_step (While mark guard body) before_state before_writer before_state before_writer
| InstrumentedWhileTrue: mark: label -> guard: boolean_expression -> body: statement -> before_state: state -> before_writer: last_writer -> middle_state: state -> middle_writer: last_writer -> after_state: state -> after_writer: last_writer -> guard_true: equality (evaluate_boolean guard before_state) true -> body_step: instrumented_big_step body before_state before_writer middle_state middle_writer -> rest_step: instrumented_big_step (While mark guard body) middle_state middle_writer after_state after_writer -> instrumented_big_step (While mark guard body) before_state before_writer after_state after_writer

let rec forget_writers (program: statement) (before_state: state) (before_writer: last_writer) (after_state: state) (after_writer: last_writer) (execution: instrumented_big_step program before_state before_writer after_state after_writer) : Tot (big_step program before_state after_state) (decreases execution) =
  match execution with | InstrumentedAssign mark name value current _writers -> begin BigStepAssign mark name value current end | InstrumentedSkip mark current _writers -> begin BigStepSkip mark current end | InstrumentedSequence first second before_state before_writer middle_state middle_writer after_state after_writer first_step second_step -> begin BigStepSequence first second before_state middle_state after_state (forget_writers first before_state before_writer middle_state middle_writer first_step) (forget_writers second middle_state middle_writer after_state after_writer second_step) end | InstrumentedIfTrue mark guard yes no before_state before_writer after_state after_writer guard_true branch -> begin BigStepIfTrue mark guard yes no before_state after_state guard_true (forget_writers yes before_state before_writer after_state after_writer branch) end | InstrumentedIfFalse mark guard yes no before_state before_writer after_state after_writer guard_false branch -> begin BigStepIfFalse mark guard yes no before_state after_state guard_false (forget_writers no before_state before_writer after_state after_writer branch) end | InstrumentedWhileFalse mark guard body before_state _before_writer guard_false -> begin BigStepWhileFalse mark guard body before_state guard_false end | InstrumentedWhileTrue mark guard body before_state before_writer middle_state middle_writer after_state after_writer guard_true body_step rest_step -> begin BigStepWhileTrue mark guard body before_state middle_state after_state guard_true (forget_writers body before_state before_writer middle_state middle_writer body_step) (forget_writers (While mark guard body) middle_state middle_writer after_state after_writer rest_step) end
#pop-options